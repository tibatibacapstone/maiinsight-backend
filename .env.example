# Environment variables for MaiinSight backend application
NODE_ENV=
PORT=5000
CLIENT_URL=http://localhost:3000
APP_URL=http://localhost:3000
DATABASE_URL="mysql://nama_app_kamu:username@localhost:port/nama_db"
# Required: use a strong, randomly generated secret. The backend will not start without it.
JWT_SECRET=<strong-random-secret>
# Required for Google login. Must match the frontend NEXT_PUBLIC_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=<MaiinSight-Google-OAuth-client-ID>

# Initial passwords used only when npm run seed must create these accounts.
# Set strong, unique values. Re-running the seed preserves existing password hashes.
# There are no development or production fallback passwords.
SEED_MARKETING_OPERATIONAL_PASSWORD=
SEED_MANAGEMENT_PASSWORD=
SEED_IT_SUPPORT_PASSWORD=

# SMTP configuration for activation emails
# Replace SMTP_USER and SMTP_PASS with your Gmail address and App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tibatibacapstone@gmail.com
SMTP_PASS=PASSWORD_APP_GMAIL_KAMU   
SMTP_FROM=MaiinSight <tibatibacapstone@gmail.com>

# Automated integration health reminder emails (Meta token expiry, Gemini connectivity)
# Sent once daily via cron to all active IT Support users. Disable with HEALTH_REMINDER_ENABLED=false.
# HEALTH_REMINDER_RECIPIENTS=ops1@maiin.com,ops2@maiin.com   # optional static override
HEALTH_REMINDER_ENABLED=true
HEALTH_REMINDER_CRON=0 9 * * *

# Gemini API configuration for MaiinSight AI Strategy Assistant
GEMINI_API_KEY=API_KEY_GEMINI_KAMU  
GEMINI_MODEL=gemini-2.5-flash

# Meta Graph / Instagram Business configuration for InstaSight
META_GRAPH_VERSION=v25.0
META_IG_USER_ID=17841454125995470
META_ACCESS_TOKEN=TOKEN_ACCESS_TOKEN_KAMU
META_PAGE_ID=
META_API_BASE_URL=https://graph.facebook.com
