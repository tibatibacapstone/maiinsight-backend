generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id             Int           @id @default(autoincrement())
  email          String        @unique
  name           String
  avatar         String?        @db.MediumText
  password       String?
  passwordResetVersion Int           @default(0)
  changePasswordCode          String?
  changePasswordCodeExpiresAt DateTime?
  isActive       Boolean       @default(true)
  role           Role          @default(operational)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  logs           ActivityLog[]
  invitesCreated UserInvite[]  @relation("InvitesCreatedBy")
  notificationReads NotificationRead[]
  importBatches     ImportBatch[]       @relation("ImportBatchPerformedBy")
  metaSyncLogs      MetaSyncLog[]       @relation("MetaSyncPerformedBy")
  segmentationRuns SegmentationRun[]   @relation("SegmentationRunPerformedBy")
  aiStrategies      AiStrategy[]        @relation("AiStrategyPerformedBy")
  aiUsageLogs       AiUsageLog[]
}

model AppSetting {
  key       String   @id @db.VarChar(100)
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@map("app_settings")
}

model UserInvite {
  id          Int       @id @default(autoincrement())
  token       String    @unique @db.VarChar(512)
  email       String
  name        String
  role        Role      @default(operational)
  createdById Int
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
  createdBy   User      @relation("InvitesCreatedBy", fields: [createdById], references: [id])

  @@index([email])
  @@index([expiresAt])
  @@index([createdById], map: "user_invites_createdById_fkey")
  @@map("user_invites")
}

model ActivityLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  action    String
  metadata  Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId], map: "ActivityLog_userId_fkey")
}

model Notification {
  id               Int             @id @default(autoincrement())
  title            String
  message          String
  role             Role
  read             Boolean         @default(false)
  createdAt        DateTime        @default(now())
  downloadRecordId Int?
  downloadRecord   DownloadRecord? @relation(fields: [downloadRecordId], references: [id], onDelete: Cascade)
  reads            NotificationRead[]
}

model DownloadRecord {
  id               Int            @id @default(autoincrement())
  fileName         String
  contentType      String         @default("text/csv; charset=utf-8")
  fileData         String         @db.MediumText
  fileSizeBytes    Int            @default(0)
  downloadedById   Int
  downloadedByName String
  createdAt        DateTime       @default(now())
  notifications    Notification[]

  @@index([downloadedById])
  @@index([createdAt])
}

model NotificationRead {
  notificationId Int
  userId         Int
  readAt         DateTime     @default(now())
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([notificationId, userId])
  @@index([userId])
  @@map("notification_reads")
}

model AiStrategy {
  id                 Int      @id @default(autoincrement())
  provider           String   @db.VarChar(50)
  model              String   @db.VarChar(100)
  targetSegmentKey   String   @db.VarChar(50)
  targetVenueKey     String?  @db.VarChar(50)
  targetSessionKey   String?  @db.VarChar(50)
  campaignObjectiveKey String? @db.VarChar(100)
  offerFrameworkKey  String?  @db.VarChar(100)
  strategy           Json
  generatedAt        DateTime @default(now())
  performedByUserId  Int?
  performedBy        User?    @relation("AiStrategyPerformedBy", fields: [performedByUserId], references: [id], onDelete: SetNull)

  @@index([generatedAt])
  @@index([targetSegmentKey])
  @@index([performedByUserId])
  @@map("ai_strategies")
}

model AiUsageLog {
  id               Int      @id @default(autoincrement())
  userId           Int?
  model            String   @db.VarChar(100)
  feature          String   @db.VarChar(100)
  promptTokens     Int      @default(0)
  candidatesTokens Int      @default(0)
  totalTokens      Int      @default(0)
  createdAt        DateTime @default(now())
  user             User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId])
  @@map("ai_usage_logs")
}

model ImportBatch {
  id                   Int                   @id @default(autoincrement())
  fileName             String
  rowCount             Int                   @default(0)
  headers              Json
  status               ImportStatus          @default(uploaded)
  errorMessage         String?               @db.Text
  errorCode            String?               @db.VarChar(50)
  errorSuggestion      String?               @db.Text
  validationErrors     Json?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  performedByUserId    Int?
  performedBy          User?                 @relation("ImportBatchPerformedBy", fields: [performedByUserId], references: [id], onDelete: SetNull)
  facilityTransactions FacilityTransaction[]
  rawTransactions      RawTransactionTable[]

  @@index([performedByUserId])
  @@map("import_batches")
}

model RawTransactionTable {
  id           Int         @id @default(autoincrement())
  batchId      Int
  rowNumber    Int
  data         Json
  status       String      @default("raw")
  errorMessage String?     @db.Text
  createdAt    DateTime    @default(now())
  batch        ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@map("raw_transaction_table")
}

model Customer {
  id                            Int                   @id @default(autoincrement())
  customerIdentity              String                @unique @db.VarChar(255)
  customerKey                   String                @unique @db.VarChar(50)
  name                          String?
  email                         String?
  phone                         String?               @db.VarChar(50)
  customerProfile               Json?
  customerKeyType               String                @db.VarChar(50)
  customerKeyConfidence         Float?
  customerType                  String                @default("unknown") @db.VarChar(50)
  membershipTransactionCount    Int                   @default(0)
  nonMembershipTransactionCount Int                   @default(0)
  internalTransactionCount      Int                   @default(0)
  customerTypeCalculatedAt      DateTime?
  createdAt                     DateTime              @default(now())
  updatedAt                     DateTime              @updatedAt
  facilityTransactions          FacilityTransaction[]

  @@map("customers")
}

model FacilityTransaction {
  id                    Int              @id @default(autoincrement())
  batchId               Int
  rawRowId              Int
  rowNumber             Int
  orderId               String?          @db.VarChar(100)
  customerId            Int?
  customerIdentity      String           @db.VarChar(255)
  customerKey           String           @db.VarChar(50)
  customerName          String?
  normalizedEmail       String?
  normalizedPhone       String?          @db.VarChar(50)
  transactionDate       DateTime?
  playDate              DateTime?
  playTime              String?          @db.VarChar(50)
  startHour             String?          @db.VarChar(10)
  endHour               String?          @db.VarChar(10)
  durationHours         Float
  court                 String           @db.VarChar(100)
  courtType             String?          @db.VarChar(50)
  bookingType           String           @db.VarChar(50)
  validBooking          Boolean          @default(false)
  bookingEventKey       String           @unique @db.VarChar(255)
  bookingRangeKey       String           @db.VarChar(255)
  netRevenue            Decimal          @db.Decimal(14, 2)
  addOnRevenue          Decimal          @db.Decimal(14, 2)
  voucherDiscount       Decimal          @db.Decimal(14, 2)
  status                String?          @db.VarChar(100)
  promoName             String?
  sportPurpose          String?
  description           String?          @db.Text
  createdAt             DateTime         @default(now())
  addOns                String?          @db.Text
  customerKeyConfidence String?          @db.VarChar(50)
  customerKeyType       String?          @db.VarChar(50)
  customerProfile       String?          @db.VarChar(100)
  deskripsi             String?          @db.Text
  email                 String?
  hargaAddOns           Decimal?         @db.Decimal(14, 2)
  hargaBersih           Decimal?         @db.Decimal(14, 2)
  hargaVoucher          Decimal?         @db.Decimal(14, 2)
  jamMain               String?          @db.VarChar(50)
  keperluan             String?          @db.VarChar(100)
  lapangan              String?          @db.VarChar(100)
  nama                  String?
  noTelepon             String?          @db.VarChar(50)
  normalizedName        String?
  period                String?          @db.VarChar(20)
  playTimeGroup         String?          @db.VarChar(30)
  promosi               String?          @db.Text
  rawData               Json?
  reschedule            String?          @db.VarChar(50)
  tanggalMain           DateTime?
  tanggalTransaksi      DateTime?
  tipeVoucher           String?          @db.VarChar(100)
  venue                 String?          @db.VarChar(100)
  courtHourUsages       CourtHourUsage[]
  batch                 ImportBatch      @relation(fields: [batchId], references: [id])
  customer              Customer?        @relation(fields: [customerId], references: [id])

  @@index([batchId])
  @@index([rawRowId])
  @@index([customerId])
  @@index([customerIdentity])
  @@index([orderId])
  @@index([nama])
  @@index([email])
  @@index([period])
  @@index([tanggalMain])
  @@index([status])
  @@index([playTimeGroup])
  @@index([playDate])
  @@index([courtType])
  @@index([bookingType])
  @@index([validBooking])
  @@index([bookingRangeKey])
  @@map("facility_transactions")
}

model CourtHourUsage {
  id            Int                 @id @default(autoincrement())
  transactionId Int
  batchId       Int
  playDate      DateTime
  hourStart     String              @db.VarChar(10)
  court         String              @db.VarChar(100)
  courtType     String?             @db.VarChar(50)
  courtHourKey  String              @unique
  hourlyRevenue Decimal             @db.Decimal(14, 2)
  createdAt     DateTime            @default(now())
  transaction   FacilityTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@index([batchId])
  @@index([playDate])
  @@index([hourStart])
  @@index([courtType])
  @@map("court_hour_usages")
}

model SegmentationRun {
  id                Int                @id @default(autoincrement())
  runDate           DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  method            String             @default("RFM_KMEANS") @db.VarChar(50)
  kValue            Int                @default(0)
  totalCustomers    Int                @default(0)
  filterMonth       String?            @db.VarChar(20)
  filterYear        Int?
  filterPeriodType  String?            @db.VarChar(10)
  filterCourtType   String?            @db.VarChar(50)
  filterBookingType String?            @db.VarChar(50)
  status            String             @default("running") @db.VarChar(50)
  errorMessage      String?            @db.Text
  silhouetteScore   Float?
  kEvaluation       Json?
  clusterProfiles   ClusterProfile[]
  customerScores    CustomerRfmScore[]
  performedByUserId Int?
  performedBy       User?              @relation("SegmentationRunPerformedBy", fields: [performedByUserId], references: [id], onDelete: SetNull)

  @@index([runDate])
  @@index([status])
  @@index([filterYear, filterMonth, filterPeriodType])
  @@index([filterCourtType, filterBookingType])
  @@index([performedByUserId])
  @@map("segmentation_runs")
}

model CustomerRfmScore {
  id                  Int             @id @default(autoincrement())
  runId               Int
  customerKey         String
  customerName        String?
  bookingTypeDominant String?         @db.VarChar(50)
  recency             Int
  frequency           Int
  monetary            Float
  rScore              Int
  fScore              Int
  mScore              Int
  clusterId           Int
  segmentName         String          @db.VarChar(100)
  createdAt           DateTime        @default(now())
  run                 SegmentationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, customerKey])
  @@index([runId])
  @@index([customerKey])
  @@index([segmentName])
  @@index([clusterId])
  @@map("customer_rfm_scores")
}

model ClusterProfile {
  id                 Int             @id @default(autoincrement())
  runId              Int
  clusterId          Int
  segmentName        String          @db.VarChar(100)
  customerCount      Int
  avgRecency         Float
  avgFrequency       Float
  avgMonetary        Float
  createdAt          DateTime        @default(now())
  avgFScore          Float?
  avgMScore          Float?
  avgRScore          Float?
  labelReason        String?         @db.Text
  segmentDescription String?         @db.Text
  run                SegmentationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, clusterId])
  @@index([runId])
  @@index([segmentName])
  @@map("cluster_profiles")
}

model MetaRawResponse {
  id           String   @id @default(cuid()) @db.VarChar(30)
  source       String   @db.VarChar(100)
  endpoint     String   @db.Text
  method       String   @default("GET") @db.VarChar(20)
  params       Json?
  responseJson Json?
  status       String   @db.VarChar(50)
  errorMessage String?  @db.Text
  fetchedAt    DateTime @default(now())

  @@map("meta_raw_responses")
}

model InstagramAccount {
  id                 String                             @id @default(cuid()) @db.VarChar(30)
  igUserId           String                             @unique @db.VarChar(100)
  username           String?                            @db.VarChar(100)
  name               String?                            @db.VarChar(150)
  followersCount     Int?
  followsCount       Int?
  mediaCount         Int?
  rawJson            Json?
  createdAt          DateTime                           @default(now())
  updatedAt          DateTime                           @updatedAt
  accountInsights    InstagramAccountInsight[]
  snapshots          InstagramAccountSnapshot[]
  audienceInsights   InstagramAudienceInsight[]
  media              InstagramMedia[]
  monthlyPerformance InstagramMonthlyMediaPerformance[]

  @@map("instagram_accounts")
}

model InstagramAccountSnapshot {
  id             String           @id @default(cuid()) @db.VarChar(30)
  accountId      String           @db.VarChar(30)
  followersCount Int?
  followsCount   Int?
  mediaCount     Int?
  snapshotDate   DateTime
  rawJson        Json?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  account        InstagramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, snapshotDate])
  @@map("instagram_account_snapshots")
}

model InstagramMedia {
  id               String                  @id @default(cuid()) @db.VarChar(30)
  igMediaId        String                  @unique @db.VarChar(100)
  accountId        String                  @db.VarChar(30)
  caption          String?                 @db.Text
  contentLabel     String?                 @db.VarChar(50)
  mediaType        String?                 @db.VarChar(50)
  mediaProductType String?                 @db.VarChar(50)
  mediaUrl         String?                 @db.Text
  thumbnailUrl     String?                 @db.Text
  permalink        String?                 @db.Text
  postedAt         DateTime?
  rawJson          Json?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  account          InstagramAccount        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  insights         InstagramMediaInsight[]

  @@index([accountId], map: "instagram_media_accountId_fkey")
  @@map("instagram_media")
}

model InstagramMediaInsight {
  id          String         @id @default(cuid()) @db.VarChar(30)
  mediaId     String         @db.VarChar(30)
  metricName  String         @db.VarChar(100)
  metricValue Float?
  period      String         @default("lifetime") @db.VarChar(50)
  insightDate DateTime
  rawJson     Json?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  media       InstagramMedia @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([mediaId, metricName, insightDate, period])
  @@index([metricName])
  @@map("instagram_media_insights")
}

model InstagramAccountInsight {
  id          String           @id @default(cuid()) @db.VarChar(30)
  accountId   String           @db.VarChar(30)
  metricName  String           @db.VarChar(100)
  metricValue Float?
  period      String           @db.VarChar(50)
  insightDate DateTime
  rawJson     Json?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  account     InstagramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, metricName, insightDate, period])
  @@index([metricName])
  @@map("instagram_account_insights")
}

model InstagramAudienceInsight {
  id             String           @id @default(cuid()) @db.VarChar(30)
  accountId      String           @db.VarChar(30)
  metricName     String           @db.VarChar(100)
  breakdownType  String           @db.VarChar(50)
  breakdownValue String
  metricValue    Float?
  period         String           @db.VarChar(50)
  insightDate    DateTime
  rawJson        Json?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  account        InstagramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, metricName, breakdownType, breakdownValue, insightDate, period])
  @@map("instagram_audience_insights")
}

model InstagramContentSummary {
  id                 String    @id @default(cuid()) @db.VarChar(30)
  mediaId            String    @db.VarChar(30)
  summary            String?   @db.Text
  performanceInsight String?   @db.Text
  recommendation     String?   @db.Text
  generatedBy        String?   @db.VarChar(100)
  generatedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([mediaId])
  @@map("instagram_content_summaries")
}

model InstagramMonthlyMediaPerformance {
  id                           String           @id @default(cuid()) @db.VarChar(30)
  accountId                    String           @db.VarChar(30)
  month                        DateTime
  contentType                  String           @db.VarChar(50)
  views                        Int              @default(0)
  viewsFromFollowers           Int              @default(0)
  viewsFromNonFollowers        Int              @default(0)
  reach                        Int              @default(0)
  reachFromFollowers           Int              @default(0)
  reachFromNonFollowers        Int              @default(0)
  interactions                 Int              @default(0)
  interactionsFromFollowers    Int              @default(0)
  interactionsFromNonFollowers Int              @default(0)
  likes                        Int              @default(0)
  comments                     Int              @default(0)
  shares                       Int              @default(0)
  saved                        Int              @default(0)
  contentCount                 Int              @default(0)
  rawJson                      Json?
  createdAt                    DateTime         @default(now())
  updatedAt                    DateTime         @updatedAt
  account                      InstagramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, month, contentType])
  @@map("instagram_monthly_media_performance")
}

model MetaSyncLog {
  id         String    @id @default(cuid()) @db.VarChar(30)
  syncType   String    @db.VarChar(100)
  status     String    @db.VarChar(50)
  message    String?   @db.Text
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  performedByUserId Int?
  performedBy User? @relation("MetaSyncPerformedBy", fields: [performedByUserId], references: [id], onDelete: SetNull)

  @@index([performedByUserId])
  @@map("meta_sync_logs")
}

enum Role {
  operational
  management
  it_support
}

enum ImportStatus {
  uploaded
  processing
  completed
  failed
}
